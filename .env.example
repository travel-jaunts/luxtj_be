LTJBE_ENV=development|production
LTJBE_OTLP_ENDPOINT={host}:{port}
LTJBE_DATABASE_URL=postgresql+asyncpg://{username}:{password}@{host}:{port}/{dbname}
# Hotel CRS + regions catalogue (optional; defaults to LTJBE_DATABASE_URL)
LTJBE_CRS_DATABASE_URL=postgresql+asyncpg://{username}:{password}@{host}:{port}/{crs_dbname}
LTJBE_DATABASE_ECHO=true
LTJBE_DATABASE_AUTO_CREATE=false
LTJBE_ADMIN_CURRENCY=INR
LTJBE_PUBLIC_BASE_URL=http://127.0.0.1:9001
LTJBE_BYPASS_PAYMENT=false
LTJBE_HTTP_MAX_RETRIES=2
LTJBE_HTTP_DEFAULT_TIMEOUT=60

# Redis — flight ResultTokens, hotel BlockRoom snapshots, HTTP response cache
LTJBE_REDIS_URL=redis://127.0.0.1:6379/0

# Browser origins allowed to call the API (comma-separated). Required in production
# when admin/web are on different hosts/subdomains.
# LTJBE_CORS_ORIGINS=https://admin.example.com,https://www.example.com,https://example.com

# Outbound API credentials (ExchangeRate-API, Twilio, Telegram, Google Maps,
# Bucket List Suggestions, booking suppliers, Razorpay) are configured in Admin →
# Integrations and stored in the database — not via env.

LTJBE_AUTH_JWT_SECRET=some-dev-secret
LTJBE_AUTH_JWT_ALGORITHM=HS256
LTJBE_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
LTJBE_AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
LTJBE_AUTH_PASSWORD_RESET_TTL_SECONDS=3600
LTJBE_AUTH_OTP_PEPPER=some-dev-pepper
LTJBE_AUTH_OTP_TTL_SECONDS=300
LTJBE_AUTH_OTP_MAX_ATTEMPTS=3

# Optional: RateHawk dump storage (default: <repo>/storage/ratehawk)
# LTJBE_RATEHAWK_STORAGE_PATH=storage/ratehawk
